{
  "name": "@bluey/jobs-automation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke": "node -e \"import('@bluey/jobs-automation').then(m => { if (!m.PublicAtsDiscoveryProvider || !m.planApplicationForm || !m.createApplicationReceipt) process.exit(1) })\""
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  }
}
