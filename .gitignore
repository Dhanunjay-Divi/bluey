/target/
**/.build/
.DS_Store

# Local reference/source snapshots used for research, not product source.
_refs/
*.zip

# Build and release output.
dist/

# Local on-device model weights (ONNX/tokenizer). Large binaries, never committed —
# fetched on first run or staged locally. See crates/cue-daemon/src/stt/model_setup.rs.
/models/
*.onnx
*.onnx.data

# Local audio fixtures used only for on-device STT smoke tests (not product source).
crates/cue-daemon/tests/fixtures/

# Local visual QA screenshots.
tmp-*.png

# bluey-server build artifacts
server/target/
server/Cargo.lock
server/*.db
server/*.db-journal
server/*.db-shm
server/*.db-wal

# Local Claude Code session config and personal agent rules.
.claude/

# Local OAuth client credentials (public client ids + Google installed-app
# secret). Injected into the daemon environment at launch; never committed.
.bluey.env
.env
.env.local
