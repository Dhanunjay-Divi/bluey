{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bluey Overlay",
  "version": "0.1.0",
  "identifier": "sh.bluey.overlay",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "Bluey",
        "width": 296,
        "height": 56,
        "x": 760,
        "y": 60,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "contentProtected": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true,
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}