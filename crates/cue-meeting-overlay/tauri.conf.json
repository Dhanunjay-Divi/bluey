{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bluey Meeting",
  "version": "0.1.0",
  "identifier": "sh.bluey.meeting",
  "build": {
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "meeting",
        "title": "Bluey Meeting",
        "width": 540,
        "height": 760,
        "x": 720,
        "y": 60,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "contentProtected": true,
        "visible": false
      },
      {
        "label": "banner",
        "title": "Bluey Meeting Banner",
        "url": "index.html?banner",
        "width": 360,
        "height": 168,
        "x": 980,
        "y": 40,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "contentProtected": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": { "csp": null },
    "macOSPrivateApi": true,
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"]
  }
}
