# Per-volume environment for one managed Bluey Jobs runner container.
# Provision this independently for every persistent volume; never share an
# admission grant, provider resource ID, or volume identity directory.

BLUEY_JOBS_API_ORIGIN=https://bluey.sh
BLUEY_JOBS_RUNNER_TOKEN=replace-with-jobs-runner-service-token
BLUEY_JOBS_WORKER_SIGNING_KEY=replace-with-32-byte-jobs-worker-signing-key
BLUEY_JOBS_RUNNER_ID=replace-with-stable-browser-pool-replica-id
BLUEY_JOBS_PROFILE_ENCRYPTION_KEY=replace-with-base64-32-byte-profile-key
BLUEY_JOBS_RUNNER_DATA=/var/lib/bluey-jobs-runner
BLUEY_JOBS_RUNNER_BUILD_ID=runner-602.1

# Mint these together through the authenticated admin admission-grant route.
# The token is single-use and expires after ten minutes.
BLUEY_JOBS_RUNNER_ADMISSION_GRANT_ID=replace-with-one-time-grant-id
BLUEY_JOBS_RUNNER_ADMISSION_GRANT_TOKEN=replace-with-one-time-grant-token
BLUEY_JOBS_RUNNER_PROVIDER=replace-with-provider-id
BLUEY_JOBS_RUNNER_PROVIDER_RESOURCE_ID=replace-with-managed-volume-resource-id
BLUEY_JOBS_RUNNER_RESOURCE_FINGERPRINT=replace-with-64-lowercase-hex-fingerprint

# Mint this separate one-time grant only after resolving the final immutable
# image and browser toolchain. It is consumed by one process instance; it is
# not volume authority and must not be persisted in the mounted data root.
BLUEY_JOBS_RUNNER_PROCESS_RUNTIME_GRANT_ID=replace-with-runtime-grant-id
BLUEY_JOBS_RUNNER_PROCESS_RUNTIME_GRANT_TOKEN=replace-with-runtime-grant-token
BLUEY_JOBS_RUNNER_IMAGE_SHA256=replace-with-64-lowercase-hex-image-digest
BLUEY_JOBS_AUTOMATION_BUNDLE_SHA256=replace-with-64-lowercase-hex-bundle-digest
BLUEY_JOBS_PLAYWRIGHT_VERSION=1.61.1
BLUEY_JOBS_CHROMIUM_REVISION=replace-with-exact-chromium-revision
BLUEY_JOBS_CHROMIUM_EXECUTABLE_SHA256=replace-with-64-lowercase-hex-executable-digest

# Public Ed25519 command-verification keys keyed by the server signing-key ID.
# Retain every key needed to verify an outstanding immutable purge command.
BLUEY_JOBS_RUNNER_SERVER_COMMAND_KEYS='{"replace-with-key-id":"replace-with-base64url-public-key"}'

PORT=8091
