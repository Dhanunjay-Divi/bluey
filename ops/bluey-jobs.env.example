# Root-owned Bluey Jobs API settings. Install as
# /etc/bluey-api/bluey-jobs.env with mode 0640 and owner root:bluey.
BLUEY_JOBS_BETA_ENABLED=0
BLUEY_JOBS_API_HOST=127.0.0.1
BLUEY_JOBS_API_PORT=8081

# Generate each value independently. Never reuse the Jobs data key as a token.
# The data key is 32 random bytes encoded as 64 hex characters or URL-safe
# base64. Tokens should contain at least 32 random bytes.
BLUEY_JOBS_DATA_KEY=replace-with-32-byte-jobs-data-key
BLUEY_JOBS_WORKER_SIGNING_KEY=replace-with-32-byte-jobs-worker-signing-key
# During a bounded rotation window only:
# BLUEY_JOBS_WORKER_SIGNING_KEY_PREVIOUS=replace-with-previous-signing-key
BLUEY_JOBS_LOCAL_RUN_CAPABILITY_KEY=replace-with-32-byte-local-run-capability-key
# During a bounded local-browser capability rotation window only:
# BLUEY_JOBS_LOCAL_RUN_CAPABILITY_KEY_PREVIOUS=replace-with-previous-capability-key
BLUEY_JOBS_WORKFLOW_TOKEN=replace-with-jobs-workflow-token
BLUEY_JOBS_RUNNER_TOKEN=replace-with-jobs-runner-token

# Jobs API limits are shared through BLUEY_REDIS_URL from the main service
# environment. Production should fail closed if Redis cannot enforce them.
BLUEY_RATE_LIMIT_REDIS_STRICT=1
BLUEY_LIMIT_JOBS_READ_PER_MIN=240
BLUEY_LIMIT_JOBS_READ_PER_MIN_BURST=120
BLUEY_LIMIT_JOBS_WRITE_PER_MIN=60
BLUEY_LIMIT_JOBS_WRITE_PER_MIN_BURST=30
BLUEY_LIMIT_JOBS_EXPENSIVE_PER_MIN=12
BLUEY_LIMIT_JOBS_EXPENSIVE_PER_MIN_BURST=6
BLUEY_LIMIT_JOBS_IDENTITY_PER_MIN=10
BLUEY_LIMIT_JOBS_IDENTITY_PER_MIN_BURST=5
BLUEY_LIMIT_JOBS_RUN_PER_MIN=60
BLUEY_LIMIT_JOBS_RUN_PER_MIN_BURST=20
BLUEY_LIMIT_JOBS_EVIDENCE_PER_MIN=12
BLUEY_LIMIT_JOBS_EVIDENCE_PER_MIN_BURST=4

# Configure these only when the corresponding private services are deployed.
# BLUEY_JOBS_WORKFLOW_ORIGIN=https://jobs-workflows.internal
# BLUEY_JOBS_RUNNER_ORIGIN=https://jobs-runner.internal
# BLUEY_JOBS_TAKEOVER_ORIGIN=https://jobs-browser.bluey.sh
