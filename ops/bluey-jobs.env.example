# Root-owned Bluey Jobs API settings. Install as
# /etc/bluey-api/bluey-jobs.env with mode 0640 and owner root:bluey.
BLUEY_JOBS_BETA_ENABLED=0
# Keep disabled until versioned Bluey Browser packages, updater metadata, and
# physical macOS/Windows install-launch canaries are complete.
BLUEY_JOBS_LOCAL_BROWSER_DISTRIBUTION_ENABLED=0
# Keep disabled until the authenticated workflow gateway, Temporal workers,
# and isolated browser pool pass the production runner canary.
BLUEY_JOBS_CLOUD_BROWSER_DISTRIBUTION_ENABLED=0
# Managed resume ranking is opt-in. Keep it off until provider keys, shared
# capacity enforcement, a positive BLUEY_UPSTREAM_SPEND_LIMIT_CENTS guard, and
# usage-ledger monitoring are all active. An unset/invalid/0 spend limit is no
# guard, never unlimited; managed provider dispatch must remain fail-closed.
# Deterministic evidence-only tailoring remains available without it.
BLUEY_JOBS_MODEL_GENERATION_ENABLED=0
# Keep read-only mailbox polling disabled until Gmail/Outlook OAuth credentials,
# redirect URIs, provider review, encrypted token storage, and worker monitoring
# are all configured and verified. The server also defaults this worker off.
BLUEY_JOBS_MAILBOX_SYNC_ENABLED=0
# BLUEY_JOBS_MAILBOX_SYNC_POLL_SECONDS=30
# Mandatory production admission boundary for managed resume generation.
# Keep the limit positive and bounded; unset, invalid, or 0 is not unlimited
# and managed paid-provider dispatch remains fail-closed.
BLUEY_UPSTREAM_SPEND_LIMIT_CENTS=1000
BLUEY_UPSTREAM_SPEND_WINDOW_HOURS=24
BLUEY_JOBS_API_HOST=127.0.0.1
BLUEY_JOBS_API_PORT=8081

# Shared candidate-feed ingestion is a separate, signed worker. Its staging
# directory is private and ephemeral; artifacts are removed after verification
# and upload. Configure the same values in the root-owned global-discovery
# override when the systemd unit is installed.
# BLUEY_JOBS_API_ORIGIN=http://127.0.0.1:8081
# BLUEY_JOBS_GLOBAL_DISCOVERY_WORKER_ID=production-global-discovery-1
# Comma-separated manifest source families. Production should start with explicit
# canaries and expand only after row-count, disk, and original-source checks pass.
# Unset means every nonempty manifest family.
# BLUEY_JOBS_GLOBAL_DISCOVERY_SOURCE_FAMILIES=lever,greenhouse
# BLUEY_JOBS_GLOBAL_DISCOVERY_POLL_MS=5000
# BLUEY_JOBS_GLOBAL_DISCOVERY_RUN_INTERVAL_MS=21600000
# BLUEY_JOBS_GLOBAL_DISCOVERY_MANIFEST_REFRESH_MS=900000
# BLUEY_JOBS_GLOBAL_DISCOVERY_ARTIFACT_TIMEOUT_MS=1800000
# BLUEY_JOBS_GLOBAL_DISCOVERY_MAX_ARTIFACT_BYTES=4294967296
# BLUEY_JOBS_GLOBAL_DISCOVERY_STAGING_DIR=/var/lib/bluey-jobs-global-discovery

# Generate each value independently. Never reuse the Jobs data key as a token.
# The data key is 32 random bytes encoded as 64 hex characters or URL-safe
# base64. Tokens should contain at least 32 random bytes.
BLUEY_JOBS_DATA_KEY=replace-with-32-byte-jobs-data-key
BLUEY_JOBS_WORKER_SIGNING_KEY=replace-with-32-byte-jobs-worker-signing-key
# During a bounded rotation window only:
# BLUEY_JOBS_WORKER_SIGNING_KEY_PREVIOUS=replace-with-previous-signing-key
BLUEY_JOBS_LOCAL_RUN_CAPABILITY_KEY=replace-with-32-byte-local-run-capability-key
# During a bounded local-browser capability rotation window only:
# BLUEY_JOBS_LOCAL_RUN_CAPABILITY_KEY_PREVIOUS=replace-with-previous-capability-key
BLUEY_JOBS_WORKFLOW_TOKEN=replace-with-jobs-workflow-token
BLUEY_JOBS_RUNNER_TOKEN=replace-with-jobs-runner-token

# Jobs API limits are shared through BLUEY_REDIS_URL from the main service
# environment. Production should fail closed if Redis cannot enforce them.
BLUEY_RATE_LIMIT_REDIS_STRICT=1
BLUEY_LIMIT_JOBS_READ_PER_MIN=240
BLUEY_LIMIT_JOBS_READ_PER_MIN_BURST=120
BLUEY_LIMIT_JOBS_WRITE_PER_MIN=60
BLUEY_LIMIT_JOBS_WRITE_PER_MIN_BURST=30
BLUEY_LIMIT_JOBS_EXPENSIVE_PER_MIN=12
BLUEY_LIMIT_JOBS_EXPENSIVE_PER_MIN_BURST=6
BLUEY_LIMIT_JOBS_IDENTITY_PER_MIN=10
BLUEY_LIMIT_JOBS_IDENTITY_PER_MIN_BURST=5
BLUEY_LIMIT_JOBS_RUN_PER_MIN=60
BLUEY_LIMIT_JOBS_RUN_PER_MIN_BURST=20
BLUEY_LIMIT_JOBS_EVIDENCE_PER_MIN=12
BLUEY_LIMIT_JOBS_EVIDENCE_PER_MIN_BURST=4

# Configure these only when the corresponding private services are deployed.
# BLUEY_JOBS_WORKFLOW_ORIGIN=https://jobs-workflows.internal
# BLUEY_JOBS_RUNNER_ORIGIN=https://jobs-runner.internal
# BLUEY_JOBS_TAKEOVER_ORIGIN=https://jobs-browser.bluey.sh
