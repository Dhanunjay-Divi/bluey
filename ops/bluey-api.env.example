# /etc/bluey-api/bluey-api.env
#
# Copy this file on the server, fill real secrets from your password manager,
# then chmod 0640 and chown root:bluey. The service runs as group bluey, so
# group-read is required. Do not commit the filled version.

# Bind to loopback when Caddy is the public ingress. Use 0.0.0.0 only inside
# an isolated container or private network with an enforcing firewall.
BLUEY_API_HOST=127.0.0.1
BLUEY_PORT=8080
BLUEY_DB_PATH=/opt/bluey-api/bluey.db
BLUEY_PUBLIC_URL=https://bluey.sh
BLUEY_JWT_SECRET=replace-with-openssl-rand-hex-32

# Signup abuse protection. Production should keep Turnstile required.
BLUEY_REQUIRE_TURNSTILE=1
BLUEY_TURNSTILE_SITE_KEY=replace-with-cloudflare-turnstile-site-key
BLUEY_TURNSTILE_SECRET_KEY=replace-with-cloudflare-turnstile-secret-key
BLUEY_TRIAL_MAX_PER_EMAIL=1
BLUEY_TRIAL_MAX_PER_DEVICE=1
BLUEY_TRIAL_MAX_PER_IP_PER_DAY=3
BLUEY_TRIAL_MAX_PER_EMAIL_DOMAIN_PER_DAY=25
BLUEY_TRIAL_MAX_PER_IP_USER_AGENT_PER_DAY=5

# Caddy is on the same host and forwards the real client IP.
BLUEY_TRUSTED_PROXIES=127.0.0.1,::1

# Billing provider.
#
# v0.2 defaults to Square. Preprod sets SQUARE_ENVIRONMENT=sandbox;
# production sets SQUARE_ENVIRONMENT=production. Keep real values only in
# /etc/bluey-api/bluey-api.env or your secret manager, never in git.
BLUEY_BILLING_PROVIDER=square
SQUARE_ENVIRONMENT=sandbox
SQUARE_SANDBOX_APPLICATION_ID=sandbox-sq0idb_xxxxx
SQUARE_SANDBOX_ACCESS_TOKEN=EAAA_sandbox_xxxxx
SQUARE_SANDBOX_LOCATION_ID=replace-with-square-sandbox-location-id
SQUARE_SANDBOX_WEBHOOK_SIGNATURE_KEY=replace-with-square-sandbox-webhook-signature-key
SQUARE_PRODUCTION_APPLICATION_ID=sq0idp_xxxxx
SQUARE_PRODUCTION_ACCESS_TOKEN=EAAA_production_xxxxx
SQUARE_PRODUCTION_LOCATION_ID=replace-with-square-production-location-id
SQUARE_PRODUCTION_WEBHOOK_SIGNATURE_KEY=replace-with-square-production-webhook-signature-key

# Optional legacy Stripe fallback. Leave unset when using Square.
# STRIPE_SECRET_KEY=sk_live_or_test_xxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Managed provider keys held by Bluey, not by the customer desktop.
# Each value may be one key or a comma-separated provider-approved key pool.
OPENAI_API_KEYS=sk-xxxxx
ANTHROPIC_API_KEYS=sk-ant-xxxxx
GEMINI_API_KEYS=xxxxx
DEEPGRAM_API_KEYS=xxxxx

# Managed answer routing.
#
# AnswerPlan is default-on in code; keep this explicit in deploy env so
# preflight/status reviews show the intended posture. Set to 0 only for a
# temporary rollback.
BLUEY_ANSWER_PLAN_ROUTING=1
#
# Optional AI fallback classifier for ambiguous AnswerPlan cases.
# Default-on in code. It uses the managed instant lane, sends only a small
# sanitized routing prompt, records owner-visible usage as answer_plan_classifier,
# and charges customers 0 cents for the hidden planning hop. Set to 0 only for
# rollback if it adds latency or misroutes in production.
BLUEY_ANSWER_PLAN_AI_FALLBACK=0
# BLUEY_ANSWER_PLAN_AI_CONFIDENCE_THRESHOLD=0.70
# BLUEY_ANSWER_PLAN_AI_TIMEOUT_MS=900
# BLUEY_ANSWER_PLAN_AI_MAX_TOKENS=180
#
# Default route policy is provider_mix: rotate top-tier providers by request id
# to avoid 429 hot spots. For an owner-controlled GLM/DeepSeek-first canary,
# set BLUEY_ROUTE_POLICY=cost_optimized after ZAI/DeepSeek keys are configured.
BLUEY_ROUTE_POLICY=provider_mix
# ZAI_API_KEYS=replace-with-zai-key
# DEEPSEEK_API_KEYS=replace-with-deepseek-key

# Optional managed web search for sourced/current answers.
#
# Keep this server-side only. If unset, Bluey continues to answer from screen,
# attachments, transcript, and saved memory/RAG without public web retrieval.
# Supported first-pass providers:
#   tavily  -> uses https://api.tavily.com/search by default
#   brave   -> uses https://api.search.brave.com/res/v1/web/search by default
#   generic -> POSTs {"query","max_results"} to BLUEY_WEB_SEARCH_ENDPOINT
# Results are capped and snippets are used as untrusted evidence; the server
# does not crawl arbitrary pages in this first pass.
# BLUEY_WEB_SEARCH_ENABLED=1
# BLUEY_WEB_SEARCH_PROVIDER=tavily
# BLUEY_WEB_SEARCH_API_KEY=replace-with-search-api-key
# BLUEY_WEB_SEARCH_ENDPOINT=
# BLUEY_WEB_SEARCH_MAX_RESULTS=3
# BLUEY_WEB_SEARCH_BUDGET_MS=1200

# Shared provider capacity/rate-limit state. Required before running more than
# one bluey-server instance. Single-node alpha can leave this unset, but prod
# should use a managed Valkey/Redis service and a per-environment namespace.
# Use rediss:// when the provider supports TLS.
# BLUEY_REDIS_URL=rediss://default:password@redis.example.com:6379
BLUEY_REDIS_NAMESPACE=bluey-preprod
BLUEY_RATE_LIMIT_REDIS_STRICT=0

# Bluey Jobs is served by the independently deployable bluey-jobs-api binary.
# Keep the API dark until an invited beta environment is ready.
BLUEY_JOBS_BETA_ENABLED=0
BLUEY_JOBS_API_PORT=8081
# 32 random bytes encoded as 64 hex characters or URL-safe base64.
BLUEY_JOBS_DATA_KEY=replace-with-32-byte-jobs-data-key
#
# Preflight profiles:
#   single-server-alpha  SQLite + optional local Redis is allowed.
#   multi-server         managed Redis/Valkey + strict mode required.
#   postgres-cutover     managed Redis/Valkey + BLUEY_DATABASE_URL required.
BLUEY_PREFLIGHT_PROFILE=single-server-alpha

# Off-host backups and object storage. Bluey uses R2/S3-compatible
# storage for release artifacts, signed manifests, backups, support zips, cloud
# exports, and raw synced artifacts. It is not the source of truth for accounts,
# ledgers, idempotency, or vector search.
#
# Backup script contract:
# OFFSITE_DESTINATION=s3://bluey-preprod/backups/api/
# BLUEY_BACKUP_S3_ENDPOINT_URL=https://<cloudflare-account-id>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=replace-with-r2-access-key-id
# AWS_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
# AWS_DEFAULT_REGION=auto
#
# Production operational log archive. This is for server/journald/file
# diagnostics only; desktop logs remain user-triggered redacted support bundles.
# Install host guards with: sudo ops/install-bluey-log-guards.sh
# BLUEY_REQUIRE_LOG_ARCHIVE=1
# BLUEY_LOG_ARCHIVE_DESTINATION=s3://bluey-preprod/preprod/logs/api
# BLUEY_LOG_STORAGE=r2
# BLUEY_LOG_R2_BUCKET=bluey-preprod
# BLUEY_LOG_R2_ENDPOINT_URL=https://<cloudflare-account-id>.r2.cloudflarestorage.com
# BLUEY_LOG_R2_ACCESS_KEY_ID=replace-with-r2-log-access-key-id
# BLUEY_LOG_R2_SECRET_ACCESS_KEY=replace-with-r2-log-secret-access-key
# BLUEY_LOG_R2_REGION=auto
BLUEY_LOG_STORAGE_PREFIX=preprod
BLUEY_UPLOAD_LOG_RETENTION_DAYS=180
BLUEY_UPLOAD_LOG_MAX_BYTES=33554432
BLUEY_LOG_LOCAL_RETENTION_DAYS=7
BLUEY_LOG_ARCHIVE_LOCAL_RETENTION_DAYS=7
BLUEY_LOG_DIR_MAX_BYTES=536870912
BLUEY_LOG_ROOT_MAX_BYTES=2147483648
BLUEY_LOG_ARCHIVE_REQUIRE_OFFHOST=0
#
# Optional release publish mirror. This is read by the release publish script,
# not by bluey-server. Public downloads may still be served from bluey.sh while
# R2 keeps signed manifests/installers/versioned artifacts for durability.
# BLUEY_RELEASE_MIRROR_DESTINATION=s3://bluey-preprod/releases/bluey-sh
# BLUEY_RELEASE_MIRROR_ENDPOINT_URL=https://<cloudflare-account-id>.r2.cloudflarestorage.com
#
# Cloud sync object-byte contract:
# BLUEY_OBJECT_BUCKET=bluey-preprod
# BLUEY_OBJECT_ENDPOINT_URL=https://<cloudflare-account-id>.r2.cloudflarestorage.com
# BLUEY_OBJECT_ACCESS_KEY_ID=replace-with-r2-access-key-id
# BLUEY_OBJECT_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
# BLUEY_OBJECT_REGION=auto
# BLUEY_OBJECT_KEY_PREFIX=bluey-cloud
# BLUEY_OBJECT_RETENTION_DAYS=365
# BLUEY_OBJECT_MAX_BYTES=26214400
# BLUEY_REQUIRE_OBJECT_STORAGE=0

# Postgres + pgvector cutover. The migration runner defaults to the
# server-runtime compatibility schema under infra/postgres/server-runtime.
# The server has a Postgres runtime adapter behind an explicit blocking DB
# boundary; run migrations and smoke staging before flipping production.
# When provisioning a managed Postgres 16+ database, run:
#   scripts/bluey-postgres-migrate.sh /etc/bluey-api/bluey-api.env
# BLUEY_SERVER_DB_BACKEND=postgres
# BLUEY_DATABASE_URL=postgres://bluey:password@db.example.com:5432/bluey

# Mandatory production admission boundary for every managed paid provider
# dispatch. Unset, invalid, or 0 means no guard is configured; that is not an
# unlimited mode, and all managed paid routes must remain disabled or fail
# closed before provider I/O. Keep provider-dashboard billing caps as a second
# independent boundary.
BLUEY_UPSTREAM_SPEND_LIMIT_CENTS=1000
BLUEY_UPSTREAM_SPEND_WINDOW_HOURS=24

# Transactional email. If unset in dev, the server logs local auth links.
# Resend shape. Bluey sends smtp.resend.com config through Resend's HTTPS API,
# because many cloud hosts block outbound SMTP ports.
BLUEY_SMTP_HOST=smtp.resend.com
BLUEY_SMTP_PORT=587
BLUEY_SMTP_USERNAME=resend
BLUEY_SMTP_PASSWORD=replace-with-resend-api-key
BLUEY_SMTP_FROM="Bluey <hello@bluey.sh>"
BLUEY_SMTP_STARTTLS=true
