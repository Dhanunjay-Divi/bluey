# Caddyfile for bluey.sh.
#
# One origin hosts both the customer web/install pages and the managed API.
# API routes reverse-proxy to the local bluey-server systemd service on
# 127.0.0.1:8080. Everything else is served from /var/www/bluey.

bluey.sh, www.bluey.sh {
    encode gzip zstd

    @bluey_api path /health /admin/* /auth/* /billing/* /pricing/* /router/* /stt/* /sync/* /rag/* /usage/* /account/me /account/usage /account/billing /account/export /account/delete

    handle @bluey_api {
        reverse_proxy 127.0.0.1:8080 {
            # Strip any client-provided X-Forwarded-* headers and write our own.
            # rate_limit::client_key() trusts XFF only when the immediate peer
            # IP is in BLUEY_TRUSTED_PROXIES. Caddy → bluey-server is loopback,
            # so 127.0.0.1 must be in BLUEY_TRUSTED_PROXIES on the server side.
            header_up -X-Forwarded-For
            header_up X-Forwarded-For {client_ip}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
        }
    }

    handle {
        root * /var/www/bluey
        try_files {path} {path}/ /index.html
        file_server
    }

    # Hardening headers.
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "interest-cohort=()"
        # Public web uses bundled CSS/JS with SRI, so no inline-script policy is needed.
        Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self' https://web.squarecdn.com https://sandbox.web.squarecdn.com; connect-src 'self' https://connect.squareup.com https://connect.squareupsandbox.com https://web.squarecdn.com https://sandbox.web.squarecdn.com; frame-src https://web.squarecdn.com https://sandbox.web.squarecdn.com; frame-ancestors 'none'"
    }

    # Standard log to syslog so journalctl shows access patterns.
    log {
        output file /var/log/caddy/bluey.access.log {
            roll_size 100mb
            roll_keep 14
            roll_keep_for 720h
        }
        format json
    }
}
