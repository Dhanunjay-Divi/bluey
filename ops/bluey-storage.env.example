# /etc/bluey-api/bluey-storage.env
#
# Root-only operations policy and credentials. This file is never loaded by
# bluey-api.service. Install root:root mode 0600 and replace every placeholder.

# Dedicated backup key: allow only list/head/get/put for this prefix. It must
# not have delete, bucket-admin, lifecycle, or lock-policy permissions.
OFFSITE_DESTINATION=s3://replace-with-backup-bucket/bluey-api-backups
BLUEY_BACKUP_S3_ENDPOINT_URL=https://replace-with-account-id.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=replace-with-prefix-scoped-backup-access-key
AWS_SECRET_ACCESS_KEY=replace-with-prefix-scoped-backup-secret-key
AWS_DEFAULT_REGION=auto

# A 58 GiB production host with ~0.93 GiB logical dumps keeps about 11 local
# snapshots and a 12 GiB backup ceiling. R2 remains the longer-lived copy.
BLUEY_BACKUP_HOURLY_KEEP=4
BLUEY_BACKUP_DAILY_KEEP=7
BLUEY_BACKUP_MIN_HOURLY_KEEP=2
BLUEY_BACKUP_MIN_DAILY_KEEP=2
# Applies only to DB hot storage: hourly + daily + in-progress staging. The
# disk guard independently evaluates the whole backup tree and root filesystem.
BLUEY_BACKUP_LOCAL_MAX_BYTES=12884901888
BLUEY_BACKUP_MAX_SNAPSHOT_BYTES=2147483648
BLUEY_BACKUP_MIN_FREE_GB=16
BLUEY_BACKUP_LOCK_WAIT_SECONDS=0
BLUEY_BACKUP_REQUIRE_OFFSITE=1
BLUEY_BACKUP_REQUIRE_STATUS=1
BLUEY_BACKUP_REQUIRE_TRUSTED_PATHS=1
BLUEY_BACKUP_STATUS_FILE=/var/backups/bluey-api/.backup.status
# The exclusive backup lock proves every pre-existing exact run.* directory is
# orphaned; the backup script removes all such directories before capacity work.

# Warn well before Bluey's hard release stop line. The hard limits remain 80%
# used or less than 8 GiB free; either one blocks promotion.
BLUEY_DISK_WARN_USED_PCT=70
BLUEY_DISK_WARN_MIN_FREE_GB=16
BLUEY_DISK_MAX_USED_PCT=80
BLUEY_DISK_MIN_FREE_GB=8
BLUEY_DISK_GUARD_STATUS_FILE=/var/lib/bluey-ops/disk-guard.status
BLUEY_DISK_GUARD_LOCK_FILE=/var/lib/bluey-ops/disk-guard.lock
BLUEY_OPS_STATE_ROOT=/var/lib/bluey-ops
BLUEY_DISK_GUARD_TMP_ROOT=/var/lib/bluey-ops/tmp
BLUEY_DISK_GUARD_REQUIRE_STATUS=1
BLUEY_DISK_GUARD_REQUIRE_TRUSTED_PATHS=1
BLUEY_DISK_GUARD_ALERT_REPEAT_MINUTES=60
BLUEY_DISK_BACKUP_HEALTH_REQUIRED=1
BLUEY_DISK_BACKUP_RUN_STATUS_REQUIRED=1
BLUEY_DISK_BACKUP_WARN_AGE_MINUTES=120
BLUEY_DISK_BACKUP_HARD_AGE_MINUTES=180
BLUEY_DISK_BACKUP_WRITER_WARN_AGE_MINUTES=45
BLUEY_DISK_BACKUP_WRITER_HARD_AGE_MINUTES=90
BLUEY_DISK_BACKUP_DAILY_HEALTH_REQUIRED=1
BLUEY_DISK_BACKUP_DAILY_WARN_AGE_MINUTES=2160
BLUEY_DISK_BACKUP_DAILY_HARD_AGE_MINUTES=2880
BLUEY_DISK_BACKUP_REQUIRE_ROOT_OWNERSHIP=1
BLUEY_DISK_LOG_ARCHIVE_HEALTH_REQUIRED=1
BLUEY_DISK_LOG_ARCHIVE_WARN_AGE_MINUTES=120
BLUEY_DISK_LOG_ARCHIVE_HARD_AGE_MINUTES=180
BLUEY_DISK_LOG_ARCHIVE_WRITER_WARN_AGE_MINUTES=45
BLUEY_DISK_LOG_ARCHIVE_WRITER_HARD_AGE_MINUTES=90
BLUEY_DISK_WARN_INODE_USED_PCT=70
BLUEY_DISK_MAX_INODE_USED_PCT=80
BLUEY_DISK_GUARD_ALERT_WEBHOOK_URL=https://replace-with-secret-alert-receiver.invalid
BLUEY_DISK_GUARD_REQUIRE_ALERT=1
BLUEY_PREFLIGHT_REQUIRE_DISK_GUARD=1
# This is intentionally a hard release stop in Phase 622. A later reviewed
# phase must replace the preflight stop with a real external provider that
# creates, monitors, expires, and closes restore-target registrations without
# depending on this host, its cron, or a locally minted marker.
BLUEY_PREFLIGHT_REQUIRE_RESTORE_DEADMAN_PROVIDER=1

# Root-owned operational cron output and persistent journald capacity bounds.
BLUEY_OPS_LOG_DIR=/var/log/bluey-ops
BLUEY_LOG_DIRS="/var/log/bluey-api /opt/bluey-api/logs /var/log/bluey-ops"
BLUEY_JOURNAL_SYSTEM_MAX_USE=1G
BLUEY_JOURNAL_SYSTEM_KEEP_FREE=16G

BLUEY_LOG_WORK_RETENTION_MINUTES=1440
BLUEY_LOG_ARCHIVE_WORK_DIR=/var/lib/bluey-ops/log-archive
BLUEY_LOG_WORK_MAX_DIRS=4
BLUEY_LOG_WORK_ROOT_MAX_BYTES=268435456
BLUEY_LOG_ARCHIVE_BUNDLE_MAX_BYTES=134217728
BLUEY_LOG_ARCHIVE_MIN_FREE_GB=16
BLUEY_LOG_ARCHIVE_LOCK_WAIT_SECONDS=0
BLUEY_LOG_ARCHIVE_REQUIRE_OFFHOST=1
BLUEY_LOG_ARCHIVE_REQUIRE_PROVIDER_RETENTION=1
BLUEY_LOG_ARCHIVE_REQUIRE_STATUS=1
BLUEY_LOG_ARCHIVE_REQUIRE_TRUSTED_PATHS=1
BLUEY_LOG_ARCHIVE_STATUS_FILE=/var/lib/bluey-ops/log-archive.status
BLUEY_LOG_ARCHIVE_DB_CONNECT_TIMEOUT_SECONDS=5
BLUEY_LOG_ARCHIVE_DB_STATEMENT_TIMEOUT_MS=10000
BLUEY_LOG_ARCHIVE_DB_WALL_TIMEOUT_SECONDS=20
BLUEY_LOG_ARCHIVE_COMMAND_TIMEOUT_SECONDS=300
BLUEY_LOG_ARCHIVE_REMOTE_TIMEOUT_SECONDS=300
BLUEY_LOG_ARCHIVE_TIMEOUT_KILL_GRACE_SECONDS=5
BLUEY_BACKUP_COMMAND_TIMEOUT_SECONDS=900
BLUEY_BACKUP_REMOTE_TIMEOUT_SECONDS=300
BLUEY_BACKUP_TIMEOUT_KILL_GRACE_SECONDS=5
BLUEY_PREFLIGHT_COMMAND_TIMEOUT_SECONDS=20
BLUEY_PREFLIGHT_TIMEOUT_KILL_GRACE_SECONDS=5

# Dedicated operational-log archive key. Keep it separate from both the backup
# key above and the application object's BLUEY_OBJECT_* credentials.
BLUEY_REQUIRE_LOG_ARCHIVE=1
BLUEY_OPS_LOG_ARCHIVE_DESTINATION=s3://replace-with-log-bucket/prod/logs/api
BLUEY_OPS_LOG_R2_BUCKET=replace-with-log-bucket
BLUEY_OPS_LOG_R2_ENDPOINT_URL=https://replace-with-account-id.r2.cloudflarestorage.com
BLUEY_OPS_LOG_R2_ACCESS_KEY_ID=replace-with-prefix-scoped-log-access-key
BLUEY_OPS_LOG_R2_SECRET_ACCESS_KEY=replace-with-prefix-scoped-log-secret-key
BLUEY_OPS_LOG_R2_REGION=auto
BLUEY_LOG_STORAGE_PREFIX=prod

# Keep the cold-candidate worker off until its eligibility query, single-row R2
# read-back canary, database tombstone, and rollback evidence are reviewed.
BLUEY_JOBS_GLOBAL_ARCHIVE_ENABLED=0
BLUEY_JOBS_GLOBAL_ARCHIVE_RETENTION_DAYS=30
BLUEY_JOBS_GLOBAL_ARCHIVE_BATCH_SIZE=25
BLUEY_JOBS_GLOBAL_ARCHIVE_POLL_SECONDS=3600
BLUEY_JOBS_GLOBAL_ARCHIVE_LEASE_SECONDS=300
